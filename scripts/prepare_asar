#!/usr/bin/env bash
set -euo pipefail

# Internal worker: never target the live resource directory.
: "${CODEX_WEB_STAGE:?Use scripts/releases prepare}"
cd "$(dirname "$0")/.."
export PATH="$PWD/node_modules/.bin:$PATH"
stage="$CODEX_WEB_STAGE"

if [[ ! -f "$stage/release.json" || -e "$stage/asar" ]]; then
  echo "Expected a new release directory with release.json and no existing asar" >&2
  exit 1
fi
mkdir -p "$stage/asar"
if [[ -n "${HOSTED_CODEX_APP_ASAR:-}" ]]; then
  asar extract "$HOSTED_CODEX_APP_ASAR" "$stage/asar"
else
  : "${HOSTED_CODEX_APP_ZIP:?Provide an app ZIP or HOSTED_CODEX_APP_ASAR}"
  unzip -q "$HOSTED_CODEX_APP_ZIP" -d "$stage/archive"
  asar extract "$stage/archive/ChatGPT.app/Contents/Resources/app.asar" "$stage/asar"
fi
node scripts/patch-plan.cjs "$stage/asar"
apply_patch_file() {
  echo "Checking and applying $1"
  patch --batch --forward --fuzz=0 --dry-run -p1 -d "$stage/asar" < "$1"
  patch --batch --forward --fuzz=0 -p1 -d "$stage/asar" < "$1"
}
cp assets/* "$stage/asar/webview/"
PWA_SOURCE_ICON="${stage}/asar/webview/assets/app-f483cb0295ed.png"
PWA_TARGET_ICON="${stage}/asar/webview/assets/pwa-icon-512.png"
PWA_ICON_SIZE=512
PWA_TOTAL_PADDING_PERCENT=25
PWA_CONTENT_SIZE=$((PWA_ICON_SIZE * (100 - PWA_TOTAL_PADDING_PERCENT) / 100))
PWA_PADDING_TOTAL=$((PWA_ICON_SIZE - PWA_CONTENT_SIZE))
PWA_PADDING_BEFORE=$((PWA_PADDING_TOTAL / 2))
PWA_PADDING_AFTER=$((PWA_PADDING_TOTAL - PWA_PADDING_BEFORE))
sharp -i "$PWA_SOURCE_ICON" -o "$PWA_TARGET_ICON" -f png resize "$PWA_CONTENT_SIZE" "$PWA_CONTENT_SIZE" --fit inside -- flatten white -- extend "$PWA_PADDING_BEFORE" "$PWA_PADDING_AFTER" "$PWA_PADDING_BEFORE" "$PWA_PADDING_AFTER" --background white -- removeAlpha
if [[ -n "${DEV:-}" ]]; then
  prettier --ignore-path /dev/null --ignore-unknown --write "${stage}/asar"
else
  patched_files=()
  while IFS= read -r patched_file; do
    patched_files+=("$patched_file")
  done < <(
    awk -v root="$stage/asar/" '/^\+\+\+ b\//{sub(/^\+\+\+ b\//, root); print}' patches/*.patch | sort -u
  )
  prettier --ignore-path /dev/null --ignore-unknown --write "${patched_files[@]}"
fi
apply_patch_file patches/webview-remove-csp.patch
apply_patch_file patches/webview-style.patch
apply_patch_file patches/webview-preload.patch
# Fetch the authenticated primary route while the renderer shell initializes.
apply_patch_file patches/webview-preload-primary.patch
# Discover the mandatory initial bundle before the shared runtime evaluates.
apply_patch_file patches/webview-preload-initial.patch
apply_patch_file patches/webview-favicon.patch
apply_patch_file patches/webview-pwa.patch
apply_patch_file patches/webview-thread-title.patch
apply_patch_file patches/webview-initial-route.patch
apply_patch_file patches/webview-electron-shim-close-sidebar.patch
apply_patch_file patches/webview-prosemirror-inputmode.patch
apply_patch_file patches/webview-use-atfs-for-local-files.patch
apply_patch_file patches/webview-statsig-override-adapter.patch
# Use the existing Statsig fallback after one failed bootstrap request instead
# of keeping the browser on the startup screen through six timeout attempts.
apply_patch_file patches/webview-statsig-bootstrap-retry.patch
apply_patch_file patches/webview-prompt-search-param.patch
apply_patch_file patches/sentry-disable-shell.patch
apply_patch_file patches/sentry-disable-webview.patch
apply_patch_file patches/preload-disable-device-check.patch
apply_patch_file patches/webview-safe-header-left.patch
apply_patch_file patches/app-host-json-rpc.patch
apply_patch_file patches/app-host-browser-windows.patch
apply_patch_file patches/webview-archive-empty-thread.patch
apply_patch_file patches/app-host-windows-files.patch
rm -rf "$stage/asar/node_modules/better-sqlite3"
apply_patch_file patches/webview-html-sidebar.patch
apply_patch_file patches/webview-browser-adapter.patch
apply_patch_file patches/webview-browser-capabilities.patch
apply_patch_file patches/webview-startup-trace.patch
apply_patch_file patches/webview-startup-visibility.patch
apply_patch_file patches/webview-statsig-startup-timeout.patch
# Give a responding bootstrap a separate bounded budget to finish its large body.
apply_patch_file patches/webview-statsig-phase-budget.patch
apply_patch_file patches/webview-startup-cache.patch
# Diagnostic only: normal startup must keep the settings readiness gate.
if [ "${CODEX_WEB_SETTINGS_PRELOAD_BYPASS:-0}" = "1" ]; then
  apply_patch_file patches/webview-settings-preload-gate.patch
fi
apply_patch_file patches/app-host-startup-http-trace.patch
apply_patch_file patches/app-host-startup-account-rpc-trace.patch
apply_patch_file patches/webview-temporary-api-gates.patch
# Load dictation sounds on use; startup WAV requests can trigger browser download helpers.
apply_patch_file patches/webview-dictation-lazy-audio.patch
apply_patch_file patches/webview-windows-terminal.patch
apply_patch_file patches/webview-windows-terminal-action.patch
# Syntax-check patched JavaScript as well as building the preload bundle.
while IFS= read -r target; do
  [[ "$target" == *.js ]] || continue
  node --check "$stage/asar/$target"
done < <(awk '/^\+\+\+ b\//{sub(/^\+\+\+ b\//, ""); print}' patches/*.patch | sort -u)
